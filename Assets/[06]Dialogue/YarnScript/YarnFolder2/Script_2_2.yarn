title: ShowcaseMain
---
// ── [Setup Camera] ────────────────────────────────────────
<<Enable_InteractableObject SystemGame false>>
<<Fix_Camera CamController true>>
<<Reset_Camera CamController>>
<<Switch_Camera CamController "MainCam">>

// ── [SHOWCASE: MoveIn + SetEmotion + Switch_Camera] ──────
// Owen arrives at position 2 → CenterCam
<<MoveIn NPC_Name.Owen 2>>
<<Switch_Camera CamController "CenterCam">>
<<SetEmotion NPC_Name.Owen "happy">>


// ── [SHOWCASE: MoveIn NPC ที่ 2 + NearLeftCam] ───────────
// Isla arrives at position 1
<<MoveIn NPC_Name.Isla 1>>
<<Switch_Camera CamController "NearLeftCam">>
<<SetEmotion NPC_Name.Isla "happy">>
<<SetLookDirection NPC_Name.Isla LookDirection.Right>>
<<SetLookDirection NPC_Name.Isla LookDirection.Left>>
<<SetLookDirection NPC_Name.Isla LookDirection.Forward>>
<<SetLookDirection NPC_Name.Isla LookDirection.Left>>

// ── [SHOWCASE: Order_Cocktail_OutName + wait_for_task] ───
<<SetLookDirection NPC_Name.Owen LookDirection.Forward>>
Owen: This is [b]my line[/b] with [b][i]some[/i] markup within[/b] of it. #line:SC_Owen_001
Owen: this is [s]stringk[/s] #line:SC_Owen_002
Owen: Right, since we're here — I'll have  [oreder]{Order_Cocktail_ByName_OutName("John Collins")}[/oreder], please. #line:SC_Owen_003

<<Reset_Camera CamController>>
<<Switch_Camera CamController "MainCam">>
<<Fix_Camera CamController false>>
<<wait_for_task SystemGame>>
<<Fix_Camera CamController true>>
<<Switch_Camera CamController "CenterCam">>

// ── [SHOWCASE: Satisfaction If/Else — Owen] ───────────────
<<if $satisfaction == Satisfaction.Perfect>>
    <<SetEmotion NPC_Name.Owen "happy">>
    Owen: Now THAT is exactly what I wanted. Spot on. #line:SC_Owen_004
    <<SetEmotion NPC_Name.Isla "happy">>
    Isla: Ooh, that looks good. Mine better be just as good. #line:SC_Isla_001
    Owen: No pressure. #line:SC_Owen_005
    -> I've been practising. #line:SC_OP_001
        Player: Been working on that one. #line:SC_AN_001
        Owen: It shows. Seriously. #line:SC_Owen_006
    -> Lucky guess. #line:SC_OP_002
        Player: Honestly? Lucky guess. #line:SC_AN_002
        <<SetEmotion NPC_Name.Owen "happy">>
        Owen: Ha! I'll take it either way. #line:SC_Owen_007
<<elseif $satisfaction == Satisfaction.Acceptable>>
    <<SetEmotion NPC_Name.Owen "neutral">>
    Owen: Not bad. Could be a touch stronger but I won't complain. #line:SC_Owen_008
    <<SetEmotion NPC_Name.Isla "neutral">>
    Isla: He's being generous, trust me. #line:SC_Isla_002
    Owen: I heard that, Isla. #line:SC_Owen_009
    -> I'll dial it up next time. #line:SC_OP_003
        Player: Noted — stronger next round. #line:SC_AN_003
        Owen: That's what I like to hear. #line:SC_Owen_010
    -> This is how it's meant to be. #line:SC_OP_004
        Player: Actually that's the correct recipe. #line:SC_AN_004
        <<SetEmotion NPC_Name.Owen "happy">>
        Owen: ...Fair point. I'll allow it. #line:SC_Owen_011
<<elseif $satisfaction == Satisfaction.Fail>>
    <<SetEmotion NPC_Name.Owen "upset">>
    Owen: Oh. Oh no. What... what is this? #line:SC_Owen_012
    <<SetEmotion NPC_Name.Isla "neutral">>
    Isla: Should I be worried about my order? #line:SC_Isla_003
    Owen: Very. #line:SC_Owen_013
    -> Sorry, let me redo it. #line:SC_OP_005
        Player: That one's on me. Let me fix it. #line:SC_AN_005
        <<SetEmotion NPC_Name.Owen "neutral">>
        Owen: Please. Quickly. #line:SC_Owen_014
    -> It's an acquired taste. #line:SC_OP_006
        Player: It's a bold flavour profile. #line:SC_AN_006
        <<SetEmotion NPC_Name.Owen "upset">>
        Owen: It's a crime against cocktails is what it is. #line:SC_Owen_015
<<endif>>

<<SetEmotion NPC_Name.Owen "neutral">>
<<Reset_Variable SystemGame>>

// ── [SHOWCASE: Order_Cocktail_OutDescription] ────────────
Isla: Okay my turn! Something {Order_Cocktail_OutDescription(NPC_Name.Isla)}, please! #line:SC_Isla_004
<<SetEmotion NPC_Name.Isla "happy">>

<<Reset_Camera CamController>>
<<Switch_Camera CamController "MainCam">>
<<Fix_Camera CamController false>>
<<wait_for_task SystemGame>>
<<Fix_Camera CamController true>>
<<Switch_Camera CamController "NearLeftCam">>

// ── [SHOWCASE: Satisfaction If/Else — Isla] ───────────────
<<if $satisfaction == Satisfaction.Perfect>>
    <<SetEmotion NPC_Name.Isla "happy">>
    Isla: This is AMAZING. Owen, try this! #line:SC_Isla_005
    <<SetLookDirection NPC_Name.Isla LookDirection.Right>>
    <<SetLookDirection NPC_Name.Owen LookDirection.Left>>
    Owen: ...Okay fine. *sip* ...Yeah. That's actually good. #line:SC_Owen_016
    Isla: Right?! #line:SC_Isla_006
    -> Really glad that hit the mark. #line:SC_OP_007
        Player: Really glad that hit the mark. #line:SC_AN_007
        Isla: Hit the mark? It hit a bullseye! #line:SC_Isla_007
    -> Owen's reaction says it all. #line:SC_OP_008
        Player: Owen's face said everything I needed to know. #line:SC_AN_008
        <<SetEmotion NPC_Name.Owen "neutral">>
        Owen: I said nothing. #line:SC_Owen_017
        <<SetEmotion NPC_Name.Isla "happy">>
        Isla: Your eyes said everything, Owen. #line:SC_Isla_008
<<elseif $satisfaction == Satisfaction.Acceptable>>
    <<SetEmotion NPC_Name.Isla "neutral">>
    Isla: Mmm... it's nice! Just a little sweet for me. #line:SC_Isla_009
    <<SetEmotion NPC_Name.Owen "happy">>
    Owen: She hates sweet things by the way. #line:SC_Owen_018
    <<SetEmotion NPC_Name.Isla "neutral">>
    Isla: Owen! #line:SC_Isla_010
    Owen: What? It's true! #line:SC_Owen_019
    -> I'll remember that — less sweet next time. #line:SC_OP_009
        Player: Noted. Less sweet next round. #line:SC_AN_009
        <<SetEmotion NPC_Name.Isla "happy">>
        Isla: You're very thoughtful, thank you. #line:SC_Isla_011
    -> Round two on me. #line:SC_OP_010
        Player: Let me make it up to you. #line:SC_AN_010
        Isla: Now we're talking. #line:SC_Isla_012
<<elseif $satisfaction == Satisfaction.Fail>>
    <<SetEmotion NPC_Name.Isla "upset">>
    Isla: Um... this is... interesting. #line:SC_Isla_013
    <<SetEmotion NPC_Name.Owen "happy">>
    Owen: Ha! Welcome to my world, Isla. #line:SC_Owen_020
    <<SetEmotion NPC_Name.Isla "neutral">>
    Isla: Is it always like this? #line:SC_Isla_014
    Owen: First round jitters. Probably. #line:SC_Owen_021
    -> I'm really sorry about that. #line:SC_OP_011
        Player: I'm really sorry about that one. #line:SC_AN_011
        <<SetEmotion NPC_Name.Isla "happy">>
        Isla: It's okay! Everyone has off days. #line:SC_Isla_015
    -> The next one will be better. #line:SC_OP_012
        Player: Trust me, the next one will be better. #line:SC_AN_012
        Isla: It can only go up from here, right? #line:SC_Isla_016
        <<SetEmotion NPC_Name.Owen "happy">>
        Owen: Statistically yes. #line:SC_Owen_022
<<endif>>

<<SetEmotion NPC_Name.Isla "neutral">>
<<Reset_Variable SystemGame>>

// ── [SHOWCASE: MoveIn NPC ที่ 3 + SetLookDirection] ──────
// Walter arrives at position 3
Isla: Oh — someone just walked in. #line:SC_Isla_017

<<MoveIn NPC_Name.Walter 3>>
<<Switch_Camera CamController "CenterCam">>
<<SetEmotion NPC_Name.Walter "neutral">>
Walter: Evening all. Don't mind me. #line:SC_Walter_001

<<SetLookDirection NPC_Name.Owen LookDirection.Right>>
<<SetLookDirection NPC_Name.Isla LookDirection.Right>>
<<wait 1>>
Owen: Walter! Didn't have you pegged as a Tuesday night man. #line:SC_Owen_023
<<SetLookDirection NPC_Name.Walter LookDirection.Left>>
Walter: Every night's a Tuesday when you're my age, son. #line:SC_Walter_002
Isla: That's either very wise or very sad. #line:SC_Isla_018
Walter: Both, probably. #line:SC_Walter_003

// ── [SHOWCASE: Switch_Camera FarRightCam — focus Walter] ─
<<Switch_Camera CamController "FarRightCam">>
<<SetLookDirection NPC_Name.Walter LookDirection.Forward>>

Walter: And you — you're the new one. I'll have something {Order_Cocktail_OutDescription(NPC_Name.Walter)}. #line:SC_Walter_004

-> Of course, coming right up. #line:SC_OP_013
    Player: Right away, sir. #line:SC_AN_013
    <<SetEmotion NPC_Name.Walter "neutral">>
    Walter: "Sir." I could get used to that. #line:SC_Walter_005
-> Any more details? #line:SC_OP_014
    Player: Anything more specific you're after? #line:SC_AN_014
    Walter: That IS specific. Get to work. #line:SC_Walter_006
-> I'll see what I can do. #line:SC_OP_015
    Player: I'll do my best. #line:SC_AN_015
    <<SetEmotion NPC_Name.Walter "neutral">>
    Walter: See that you do. #line:SC_Walter_007

<<Reset_Camera CamController>>
<<Switch_Camera CamController "MainCam">>
<<Fix_Camera CamController false>>
<<wait_for_task SystemGame>>
<<Fix_Camera CamController true>>
<<Switch_Camera CamController "FarRightCam">>

// ── [SHOWCASE: Satisfaction If/Else — Walter + multi-NPC reactions] ──
<<if $satisfaction == Satisfaction.Perfect>>
    <<SetEmotion NPC_Name.Walter "happy">>
    Walter: ...Well. That is exactly right. #line:SC_Walter_008
    <<SetEmotion NPC_Name.Owen "happy">>
    Owen: High praise from Walter. Rarer than the drink itself. #line:SC_Owen_024
    <<SetEmotion NPC_Name.Isla "happy">>
    Isla: We're witnessing history! #line:SC_Isla_019
    <<SetEmotion NPC_Name.Walter "neutral">>
    Walter: Don't push it. #line:SC_Walter_009
    -> That means a lot coming from you. #line:SC_OP_016
        Player: That means a lot coming from you, sir. #line:SC_AN_016
        <<SetEmotion NPC_Name.Walter "happy">>
        Walter: Don't let it go to your head. ...Good work. #line:SC_Walter_010
    -> Just doing my job. #line:SC_OP_017
        Player: Just doing my job. #line:SC_AN_017
        Walter: And doing it well. Don't stop. #line:SC_Walter_011
<<elseif $satisfaction == Satisfaction.Acceptable>>
    <<SetEmotion NPC_Name.Walter "neutral">>
    Walter: Mm. Passable. #line:SC_Walter_012
    <<SetEmotion NPC_Name.Owen "neutral">>
    Owen: Coming from Walter, that's basically a five-star review. #line:SC_Owen_025
    Walter: It is not. #line:SC_Walter_013
    <<SetEmotion NPC_Name.Isla "happy">>
    Isla: It kind of is though. #line:SC_Isla_020
    Walter: ...Drink your cocktails, both of you. #line:SC_Walter_014
    -> I'll keep improving. #line:SC_OP_018
        Player: I'll keep working on it. #line:SC_AN_018
        <<SetEmotion NPC_Name.Walter "neutral">>
        Walter: See that you do. There's potential here. #line:SC_Walter_015
    -> Appreciate the honesty. #line:SC_OP_019
        Player: Thanks for the honest feedback. #line:SC_AN_019
        Walter: Always. It's the only kind worth giving. #line:SC_Walter_016
<<elseif $satisfaction == Satisfaction.Fail>>
    <<SetEmotion NPC_Name.Walter "upset">>
    Walter: ...No. No, that's not right at all. #line:SC_Walter_017
    <<SetEmotion NPC_Name.Owen "neutral">>
    Owen: He sort of warned you. #line:SC_Owen_026
    <<SetEmotion NPC_Name.Isla "neutral">>
    Isla: To be fair, mine wasn't perfect either. #line:SC_Isla_021
    Walter: Standards, people. Standards. #line:SC_Walter_018
    -> Let me try again. #line:SC_OP_020
        Player: Let me make you another. #line:SC_AN_020
        <<SetEmotion NPC_Name.Walter "neutral">>
        Walter: Please. And take your time this round. #line:SC_Walter_019
    -> What specifically went wrong? #line:SC_OP_021
        Player: What should I fix? #line:SC_AN_021
        Walter: Everything. But start with the basics. #line:SC_Walter_020
<<endif>>

<<SetEmotion NPC_Name.Walter "neutral">>
<<Reset_Variable SystemGame>>

// ── [SHOWCASE: SetLookDirection ทุกตัวพร้อมกัน + Wrap Up] 
<<Switch_Camera CamController "CenterCam">>

Walter: You know, I've been coming to bars like this for forty years. #line:SC_Walter_021
<<SetLookDirection NPC_Name.Walter LookDirection.Left>>
<<wait 0.4>>
<<SetLookDirection NPC_Name.Owen LookDirection.Left>>
<<SetLookDirection NPC_Name.Isla LookDirection.Left>>
<<wait 0.8>>
Walter: Seen good bartenders, bad ones. Everything in between. #line:SC_Walter_022
<<SetLookDirection NPC_Name.Walter LookDirection.Forward>>
<<SetLookDirection NPC_Name.Owen LookDirection.Forward>>
<<SetLookDirection NPC_Name.Isla LookDirection.Forward>>

Owen: And where do we rank so far? #line:SC_Owen_027
Walter: ...Ask me again in a few months. #line:SC_Walter_023

// ── [SHOWCASE: Option Timeout ในฉาก Wrap Up] ─────────────
-> Hope to see you all again soon. ? #line:SC_OP_022
    Player: Hope to see you all again soon. #line:SC_AN_022
    <<SetEmotion NPC_Name.Walter "happy">>
    Walter: If the drinks keep improving — certainly. #line:SC_Walter_024
    <<SetEmotion NPC_Name.Owen "happy">>
    Owen: I'll be back tomorrow. This place grows on you. #line:SC_Owen_028
    <<SetEmotion NPC_Name.Isla "happy">>
    Isla: Same! This was really fun. #line:SC_Isla_022
-> Really glad you all came in tonight. ? #line:SC_OP_023
    Player: Really glad you all came in tonight. #line:SC_AN_023
    <<SetEmotion NPC_Name.Isla "happy">>
    Isla: Us too! Right, Walter? #line:SC_Isla_023
    <<SetEmotion NPC_Name.Walter "happy">>
    Walter: ...Sure. Right. #line:SC_Walter_025
-> You know where to find me. ? #line:SC_OP_024
    Player: You know where to find me. #line:SC_AN_024
    <<SetEmotion NPC_Name.Owen "happy">>
    Owen: Ha! Confidence. Good. #line:SC_Owen_029
-> No rush — take your time. #fallback #line:SC_OP_025
    Player: No rush, stay as long as you like. #line:SC_AN_025
    <<SetEmotion NPC_Name.Walter "neutral">>
    Walter: Don't mind if I do. #line:SC_Walter_026

// ── [SHOWCASE: MoveOut ทุกตัวละคร] ──────────────────────
<<SetEmotion NPC_Name.Owen "neutral">>
<<SetEmotion NPC_Name.Isla "neutral">>
<<SetEmotion NPC_Name.Walter "neutral">>

Owen: Right then. Night. #line:SC_Owen_030
<<MoveOut NPC_Name.Owen>>

Isla: Byeee! See you next time! #line:SC_Isla_024
<<MoveOut NPC_Name.Isla>>

Walter: Mm. Not bad. #line:SC_Walter_027
<<MoveOut NPC_Name.Walter>>

<<Switch_Camera CamController "MainCam">>
<<Fix_Camera CamController false>>
<<wait 3>>
<<Can_End_Shift SystemGame>>

===
