title: Script_2_2
---
<<enum TypeOfCocktail>>
    <<case None>>
    <<case HighAlcohol>>
    <<case LowAlcohol>>
    <<case NoneAlcohol>>
    <<case NotMatch>>
<<endenum>>
<<enum Satisfaction>>
    <<case None>>
    <<case Fail>>
    <<case Acceptable>>
    <<case Perfect>>
<<endenum>>
<<enum NPC_Name>>
    <<case None>>
    <<case Cole>>
    <<case Owen>>
    <<case Walter>>
    <<case Freya>>
    <<case Isla>>
<<endenum>>
<<enum LookDirection>>
    <<case None>>
    <<case Right>>
    <<case Left>>
    <<case Forward>>
<<endenum>>
// Declare the variable (set false by default)
<<declare $type_of_cocktail = TypeOfCocktail.None>>
<<declare $satisfaction = Satisfaction.None>>

<<Enable_InteractableObject SystemGame false>>
<<Fix_Camera CamController true>>
<<Reset_Camera CamController>>
<<Switch_Camera CamController "MainCam">>
<<jump ShowcaseMain>>
===

title: TestSaveLoad
---
// ── [Setup Camera] ────────────────────────────────────────
<<Enable_InteractableObject SystemGame false>>
<<Fix_Camera CamController true>>
<<Reset_Camera CamController>>
<<Switch_Camera CamController "MainCam">>

// Owen arrives at position 2 → CenterCam
<<MoveIn NPC_Name.Owen 2>>
<<Switch_Camera CamController "CenterCam">>
<<SetEmotion NPC_Name.Owen "happy">>

// Isla arrives at position 1
<<MoveIn NPC_Name.Isla 1>>
<<Switch_Camera CamController "NearLeftCam">>
<<SetEmotion NPC_Name.Isla "happy">>
<<SetLookDirection NPC_Name.Isla LookDirection.Right>>
<<wait_scene 1>>
<<SetLookDirection NPC_Name.Isla LookDirection.Left>>
<<wait_scene 1>>
<<SetLookDirection NPC_Name.Isla LookDirection.Forward>>

// ── [SHOWCASE: Order_Cocktail_OutName + wait_for_task] ───
<<SetLookDirection NPC_Name.Owen LookDirection.Forward>>

<<detour TestSaveLoadDetour>>

Owen: This is going to be on Save While in Phase Making cocktails. #line:TSL_Owen_003

Owen: Right, since we're here — I'll have  [oreder]{Order_Cocktail_ByName_OutName("John Collins")}[/oreder], please. #line:TSL_Owen_004
<<Reset_Camera CamController>>
<<Switch_Camera CamController "MainCam">>
<<Fix_Camera CamController false>>

<<wait_for_task SystemGame>>

<<Fix_Camera CamController true>>

Owen: after this will be show you a satisfaction of cocktails you make #line:TSL_Owen_Suggest

Isla: I Think you save right? then go next to that part. #line:TSL_Isla_Suggest

<<jump TestSaveLoad_Jump>>
===

title: TestSaveLoad_Jump
---
<<if $satisfaction == Satisfaction.Perfect>>    
    <<SetEmotion NPC_Name.Owen "happy">>
    Owen: Now THAT is exactly what I wanted. Spot on. #line:TSL_Owen_104
    <<SetEmotion NPC_Name.Isla "happy">>
    Isla: Ooh, that looks good. Mine better be just as good. #line:TSL_Isla_101
    Owen: No pressure. #line:TSL_Owen_105
    -> I've been practising. #line:TSL_OP_101
        Player: Been working on that one. #line:TSL_AN_001
        Owen: It shows. Seriously. #line:TSL_Owen_006
    -> Lucky guess. #line:TSL_OP_002
        Player: Honestly? Lucky guess. #line:TSL_AN_002
        <<SetEmotion NPC_Name.Owen "happy">>
        Owen: Ha! I'll take it either way. #line:TSL_Owen_007
<<elseif $satisfaction == Satisfaction.Acceptable>>
    <<SetEmotion NPC_Name.Owen "neutral">>
    Owen: Not bad. Could be a touch stronger but I won't complain. #line:TSL_Owen_208
    <<SetEmotion NPC_Name.Isla "neutral">>
    Isla: He's being generous, trust me. #line:TSL_Isla_202
    Owen: I heard that, Isla. #line:TSL_Owen_209
    -> I'll dial it up next time. #line:TSL_OP_203
        Player: Noted — stronger next round. #line:TSL_AN_203
        Owen: That's what I like to hear. #line:TSL_Owen_210
    -> This is how it's meant to be. #line:TSL_OP_204
        Player: Actually that's the correct recipe. #line:TSL_AN_204
        <<SetEmotion NPC_Name.Owen "happy">>
        Owen: ...Fair point. I'll allow it. #line:TSL_Owen_211
<<elseif $satisfaction == Satisfaction.Fail>>
    <<SetEmotion NPC_Name.Owen "upset">>
    Owen: Oh. Oh no. What... what is this? #line:TSL_Owen_312
    <<SetEmotion NPC_Name.Isla "neutral">>
    Isla: Should I be worried about my order? #line:TSL_Isla_303
    Owen: Very. #line:TSL_Owen_313
    -> Sorry, let me redo it. #line:TSL_OP_305
        Player: That one's on me. Let me fix it. #line:TSL_AN_305
        <<SetEmotion NPC_Name.Owen "neutral">>
        Owen: Please. Quickly. #line:TSL_Owen_314
    -> It's an acquired taste. #line:TSL_OP_306
        Player: It's a bold flavour profile. #line:TSL_AN_306
        <<SetEmotion NPC_Name.Owen "upset">>
        Owen: It's a crime against cocktails is what it is. #line:TSL_Owen_315
<<endif>>
<<Reset_Variable SystemGame>>
<<Switch_Camera CamController "CenterCam">>
===

